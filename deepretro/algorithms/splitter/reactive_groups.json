{
  "_description": "Post-processing lookup for r-BRICS fragments.  Replace each [n*] dummy with 'cap'.  The dummy carries the label of the atom it is bonded to (same convention as BreakrBRICSBonds).  Isotope >= 500 signals the complement side of a symmetric cut.",

  "replacements": {
    "1":   { "cap": "Cl",  "group": "acid chloride" },
    "3":   { "cap": "[H]", "group": "alcohol (-OH)" },
    "4":   { "cap": "Br",  "group": "alkyl bromide" },
    "5":   { "cap": "[H]", "group": "amine (-NH2)" },
    "6":   { "cap": "Cl",  "group": "acid chloride (Friedel-Crafts)" },
    "7":   { "cap": "[H]", "group": "terminal alkene" },
    "8":   { "cap": "Br",  "group": "N-alkyl bromide" },
    "9":   { "cap": "[H]", "group": "ring NH" },
    "10":  { "cap": "[H]", "group": "lactam NH" },
    "11":  { "cap": "[H]", "group": "thiol (-SH)" },
    "12":  { "cap": "Cl",  "group": "sulfonyl chloride" },
    "13":  { "cap": "Br",  "group": "ring-junction halide" },
    "14":  { "cap": "Br",  "group": "heteroaryl bromide" },
    "15":  { "cap": "Br",  "group": "cyclic C bromide" },
    "16":  { "cap": "Br",  "group": "aryl bromide" },
    "17":  { "cap": "Br",  "group": "branch-point bromide" },
    "18":  { "cap": "C=C", "group": "fused ring (RCM alkene)" },
    "19":  { "cap": "C=C", "group": "ring bond (RCM alkene)" },
    "20":  { "cap": "Br",  "group": "chain bromide" },
    "21":  { "cap": "Br",  "group": "chain bromide" },
    "22":  { "cap": "Br",  "group": "chain bromide" },
    "23":  { "cap": "Br",  "group": "chain bromide" },
    "30":  { "cap": "[H]", "group": "terminal alkyne" },
    "51":  { "cap": "[H]", "group": "amine (N-N / N-O)" },
    "81":  { "cap": "Cl",  "group": "activated amidine" },
    "182": { "cap": "C=C", "group": "fused ring double-bond (RCM alkene)" },
    "192": { "cap": "C=C", "group": "ring double-bond (RCM alkene)" }
  },

  "complements": {
    "_rule": "When a symmetric cut gives both sides the same cap, flip one side (isotope >= 500) to the complement so the two fragments can react.",
    "Br":  { "cap": "B(O)O", "group": "boronic acid", "reaction": "Suzuki coupling" },
    "Cl":  { "cap": "O",     "group": "carboxylate",  "reaction": "ester / amide formation" }
  },

  "reaction_names": {
    "_note": "Human-readable reaction names for common label pairs (reporting only).",
    "1-3":   "Fischer esterification",
    "1-5":   "amide bond formation",
    "1-10":  "lactam opening / amide",
    "3-4":   "Williamson ether synthesis",
    "3-13":  "ether formation",
    "3-14":  "aryl ether (SNAr)",
    "3-16":  "aryl ether (Ullmann)",
    "4-5":   "reductive amination / N-alkylation",
    "4-11":  "thioether synthesis",
    "5-12":  "sulfonamide formation",
    "5-14":  "Buchwald-Hartwig amination",
    "5-16":  "Buchwald-Hartwig amination",
    "6-16":  "Friedel-Crafts acylation",
    "7-7":   "olefin metathesis",
    "8-16":  "Suzuki coupling (alkyl-aryl)",
    "12-12": "disulfonyl coupling",
    "13-16": "Suzuki coupling (ring-aryl)",
    "14-14": "Suzuki coupling (heteroaryl-heteroaryl)",
    "14-16": "Suzuki coupling (heteroaryl-aryl)",
    "16-16": "Suzuki coupling (aryl-aryl)",
    "17-17": "Suzuki coupling (branch-branch)",
    "18-19": "fused ring reconnection",
    "20-21": "chain reconnection",
    "22-23": "chain reconnection",
    "30-14": "Sonogashira coupling",
    "30-16": "Sonogashira coupling",
    "30-30": "Glaser coupling"
  }
}
